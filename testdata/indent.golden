// Case bodies are one deeper than the switch or select, not two: 8+71=79 fits.
func caseBody(ch chan int) {
	switch {
	case true:
		processItem(longArgAlphaBravo, longArgCharlieDelta, longArgEchoFoxtrot)
	}
	select {
	case <-ch:
		processItem(longArgAlphaBravo, longArgCharlieDelta, longArgEchoFoxtrot)
	}
}

// Case bodies: 12+71=83 does not fit.
func caseBodyDeeper(ch chan int) {
	if true {
		switch {
		case true:
			processItem(
				longArgAlphaBravo,
				longArgCharlieDelta,
				longArgEchoFoxtrot,
			)
		}
		select {
		case <-ch:
			processItem(
				longArgAlphaBravo,
				longArgCharlieDelta,
				longArgEchoFoxtrot,
			)
		}
	}
}

