package main

// Call arguments: 8+72=80 fits.
func callArgs() {
	outer(
		processItem(longArgAlphaBravo, longArgCharlieDelta, longArgEchoFoxtrot),
	)
}

// Call arguments: 12+72=84 does not fit.
func callArgsDeeper() {
	if true {
		outer(processItem(
			longArgAlphaBravo,
			longArgCharlieDelta,
			longArgEchoFoxtrot,
		))
	}
}

